# Database (Neon/Vercel Postgres)
POSTGRES_URL=
DATABASE_URL=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (developers.google.com/identity)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth (developers.facebook.com/apps) - currently disabled, see
# app/api/auth/[...nextauth]/route.ts
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Email magic-link login (SMTP). Example for Gmail with an App Password
# (myaccount.google.com/apppasswords, requires 2-Step Verification):
# EMAIL_SERVER=smtp://your-address@gmail.com:app-password@smtp.gmail.com:587
EMAIL_SERVER=
EMAIL_FROM=
